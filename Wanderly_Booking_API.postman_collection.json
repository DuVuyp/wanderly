							"    pm.collectionVariables.set(\"booking_id\", jsonData.data.id);",
							"}",
							"pm.test(\"Status is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
